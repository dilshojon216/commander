{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AskQuestion.json",
  "title": "AskQuestion",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "header": {
      "default": "",
      "type": "string",
      "maxLength": 64
    },
    "options": {
      "minItems": 2,
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "AskOption.json"
      }
    },
    "multiSelect": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "question",
    "header",
    "options",
    "multiSelect"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "QueueTrigger.json",
  "title": "QueueTrigger",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "now"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "limit_reset"
        },
        "window": {
          "$ref": "QueueWindow.json"
        }
      },
      "required": [
        "type",
        "window"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "at"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "type",
        "at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cron"
        },
        "cron": {
          "type": "string",
          "minLength": 9,
          "maxLength": 100
        },
        "timezone": {
          "default": "Asia/Tashkent",
          "type": "string",
          "const": "Asia/Tashkent"
        }
      },
      "required": [
        "type",
        "cron",
        "timezone"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "machine_idle"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}

        {
          "$ref": "LimitWindowView.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "sevenDay": {
      "anyOf": [
        {
          "$ref": "LimitWindowView.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "pace": {
      "anyOf": [
        {
          "$ref": "WeeklyPace.json"
        },
        {
          "type": "null"
        }
      ]

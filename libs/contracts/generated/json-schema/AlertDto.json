{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AlertDto.json",
  "title": "AlertDto",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "$ref": "AlertKind.json"
    },
    "state": {
      "$ref": "AlertState.json"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "machineId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionName": {
      "type": [
        "string",
        "null"
      ]
    },
    "projectName": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "null"
        ]
      }
    },
    "remindersSent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "autoStopped": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "state",
    "sessionId",
    "machineId",
    "projectId",
    "sessionName",
    "projectName",
    "title",
    "detail",
    "metrics",
    "remindersSent",
    "autoStopped",
    "createdAt",
    "updatedAt",
    "resolvedAt"
  ],
  "additionalProperties": false
}

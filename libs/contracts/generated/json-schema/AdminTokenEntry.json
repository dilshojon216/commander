{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AdminTokenEntry.json",
  "title": "AdminTokenEntry",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "$ref": "AdminTokenState.json"
    },
    "createdAt": {
      "type": "string"
    },
    "lastUsedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "revokedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "scopes",
    "state",
    "createdAt",
    "lastUsedAt",
    "expiresAt",
    "revokedAt"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ServerAuthErrorMessage.json",
  "title": "ServerAuthErrorMessage",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "const": "auth.error"
    },
    "ts": {
      "$ref": "EpochMs.json"
    },
    "payload": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "ClientAuthErrorCode.json"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}

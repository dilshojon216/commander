{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RemoteControlState.json",
  "title": "RemoteControlState",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "since": {
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^https:\\/\\/claude\\.ai\\/code\\/session_[A-Za-z0-9]{8,64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "enabled",
    "name",
    "since"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HealthSummaryItem.json",
  "title": "HealthSummaryItem",
  "type": "object",
  "properties": {
    "machineId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "online": {
      "type": "boolean"
    },
    "status": {
      "$ref": "HealthStatus.json"
    },
    "cpuPct": {
      "type": [
        "number",
        "null"
      ]
    },
    "memPct": {
      "type": [
        "number",
        "null"
      ]
    },
    "diskMaxPct": {
      "type": [
        "number",
        "null"
      ]
    },
    "diskMaxMount": {
      "type": [
        "string",
        "null"
      ]
    },
    "containersTotal": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "containersBad": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "failedUnits": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "receivedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "openIncidents": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "machineId",
    "name",
    "online",
    "status",
    "cpuPct",
    "memPct",
    "diskMaxPct",
    "diskMaxMount",
    "containersTotal",
    "containersBad",
    "failedUnits",
    "receivedAt",
    "openIncidents"
  ],
  "additionalProperties": false
}

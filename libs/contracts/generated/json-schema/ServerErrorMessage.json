{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ServerErrorMessage.json",
  "title": "ServerErrorMessage",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "const": "error"
    },
    "ts": {
      "$ref": "EpochMs.json"
    },
    "payload": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_message",
            "unknown_type",
            "rate_limited",
            "not_authenticated"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}

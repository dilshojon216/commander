{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PaceSettings.json",
  "title": "PaceSettings",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "softPct": {
      "type": "number",
      "minimum": 1,
      "maximum": 500
    },
    "hardPct": {
      "type": "number",
      "minimum": 1,
      "maximum": 500
    },
    "enforce": {
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "softPct",
    "hardPct",
    "enforce"
  ],
  "additionalProperties": false
}

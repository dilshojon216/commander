{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ServerSubscribedMessage.json",
  "title": "ServerSubscribedMessage",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "const": "subscribed"
    },
    "ts": {
      "$ref": "EpochMs.json"
    },
    "payload": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "$ref": "ClientChannel.json"
          }
        }
      },
      "required": [
        "channels"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UnattributedTasks.json",
  "title": "UnattributedTasks",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "const": "vazifasiz"
    },
    "tokens": {
      "$ref": "TokenTotals.json"

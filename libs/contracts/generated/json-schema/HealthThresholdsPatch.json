{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HealthThresholdsPatch.json",
  "title": "HealthThresholdsPatch",
  "type": "object",
  "properties": {
    "diskWarnPct": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "diskCriticalPct": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "memPct": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "memForMin": {
      "type": "number",
      "minimum": 1,
      "maximum": 1440
    },
    "cpuPct": {
      "type": "number",
      "minimum": 1,
      "maximum": 100
    },
    "cpuForMin": {
      "type": "number",
      "minimum": 1,
      "maximum": 1440
    },
    "restartLoopCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "restartLoopWindowMin": {
      "type": "number",
      "minimum": 1,
      "maximum": 1440
    },
    "offlineAfterMin": {
      "type": "number",
      "minimum": 1,
      "maximum": 10080
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CreateOrchestrationBody.json",
  "title": "CreateOrchestrationBody",
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "lead": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session"
            },
            "sessionId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "type",
            "sessionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "new"
            },
            "machineId": {
              "type": "string",
              "format": "uuid"
            },
            "cwd": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
            },
            "permissionMode": {
              "default": "default",
              "$ref": "OrchPermissionMode.json"
            }
          },
          "required": [
            "type",
            "machineId",
            "cwd"
          ],
          "additionalProperties": false
        }
      ]
    },
    "taskKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tokenBudget": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 100000000
    },
    "maxConcurrent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxNewSessions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    }
  },
  "required": [
    "goal",
    "projectId",
    "lead"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MachineHealthResponse.json",
  "title": "MachineHealthResponse",
  "type": "object",
  "properties": {
    "machineId": {
      "type": "string",
      "format": "uuid"
    },
    "range": {
      "$ref": "HealthRange.json"
    },
    "status": {
      "$ref": "HealthStatus.json"
    },
    "latest": {
      "anyOf": [
        {
          "$ref": "HealthSnapshot.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "receivedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "HealthSeriesPoint.json"
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "$ref": "HealthIncidentDto.json"
      }
    },
    "thresholds": {
      "$ref": "HealthThresholds.json"
    }
  },
  "required": [
    "machineId",
    "range",
    "status",
    "latest",
    "receivedAt",
    "series",
    "incidents",
    "thresholds"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UsageSummaryResponse.json",
  "title": "UsageSummaryResponse",
  "type": "object",
  "properties": {
    "today": {
      "$ref": "UsageSummaryPeriod.json"
    },
    "last7d": {
      "$ref": "UsageSummaryPeriod.json"
    },
    "last30d": {
      "$ref": "UsageSummaryPeriod.json"
    },
    "allTime": {
      "$ref": "UsageSummaryPeriod.json"
    },
    "timezone": {
      "type": "string",
      "const": "Asia/Tashkent"
    },
    "costKind": {
      "type": "string",
      "const": "api_equivalent"
    }
  },
  "required": [
    "today",
    "last7d",
    "last30d",
    "allTime",
    "timezone",
    "costKind"
  ],
  "additionalProperties": false
}

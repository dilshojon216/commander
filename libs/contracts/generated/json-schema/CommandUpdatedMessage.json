{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CommandUpdatedMessage.json",
  "title": "CommandUpdatedMessage",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "const": "command.updated"
    },
    "ts": {
      "$ref": "EpochMs.json"
    },
    "payload": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "CommandDto.json"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ChatOpenPayload.json",
  "title": "ChatOpenPayload",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "before": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "sessionId"
  ],
  "additionalProperties": false
}

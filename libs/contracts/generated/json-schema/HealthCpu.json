{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HealthCpu.json",
  "title": "HealthCpu",
  "type": "object",
  "properties": {
    "pct": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "load1": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "load5": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "load15": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "null"
        }
      ]
    },
    "cores": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "perCore": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    }
  },
  "required": [
    "pct",
    "cores"
  ],
  "additionalProperties": false
}

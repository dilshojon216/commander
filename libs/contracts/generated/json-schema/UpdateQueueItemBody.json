{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UpdateQueueItemBody.json",
  "title": "UpdateQueueItemBody",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,59}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trigger": {
      "$ref": "QueueTrigger.json"
    }
  },
  "additionalProperties": false
}

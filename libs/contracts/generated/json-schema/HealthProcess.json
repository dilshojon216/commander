{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HealthProcess.json",
  "title": "HealthProcess",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cpuPct": {
      "type": "number",
      "minimum": 0,
      "maximum": 409600
    },
    "memPct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "name",
    "cpuPct",
    "memPct"
  ],
  "additionalProperties": false
}

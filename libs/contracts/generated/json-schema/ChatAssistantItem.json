{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ChatAssistantItem.json",
  "title": "ChatAssistantItem",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ts": {
      "$ref": "EpochMs.json"
    },
    "kind": {
      "type": "string",
      "const": "assistant"
    },
    "text": {
      "type": "string",
      "maxLength": 16000
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model": {
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "id",
    "ts",
    "kind",
    "text"
  ],
  "additionalProperties": false
}

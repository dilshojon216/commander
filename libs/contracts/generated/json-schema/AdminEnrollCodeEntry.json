{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AdminEnrollCodeEntry.json",
  "title": "AdminEnrollCodeEntry",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "machineName": {
      "type": "string"
    },
    "state": {
      "$ref": "AdminEnrollCodeState.json"
    },
    "createdAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "usedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "machineName",
    "state",
    "createdAt",
    "expiresAt",
    "usedAt"
  ],
  "additionalProperties": false
}

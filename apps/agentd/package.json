{
  "name": "@commander/agentd",
  "version": "0.1.0",
  "description": "Commander agentd: har mashinadagi daemon (outbound WSS, outbox, hook/OTLP/statusline qabul qiluvchilar)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agentd": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/cli.js run",
    "start": "node dist/cli.js run",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@commander/contracts": "*",
    "js-yaml": "^4.3.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.2"
  }
}

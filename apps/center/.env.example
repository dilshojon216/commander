# Server port (default 4317)
PORT=4317

# PostgreSQL connection string (required)
DATABASE_URL=postgres://commander:commander@localhost:5432/commander

# AUTH_TOKEN olib tashlangan (M-10, 2026-11-14): legacy POST /events va GET /sessions yo'q. Mashinalar faqat agentd (per-device Ed25519),
# klientlar faqat `cmdr_` tokenlari bilan kiradi. Eski .env'dagi AUTH_TOKEN qatori e'tiborsiz (o'chirib tashlang).

# Sessions with no events for this many minutes are hidden from active lists (default 720)
STALE_MINUTES=720

# --- docker-compose only ---
POSTGRES_PASSWORD=commander

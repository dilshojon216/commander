# Commander center manzili (server tomonda; default: http://127.0.0.1:4317)
COMMANDER_API_URL=http://127.0.0.1:4317
# Klient token, `read` scope (brauzerga HECH QACHON chiqmaydi):
#   bash ops/mac/commander-admin.sh token create --kind web --name dashboard-read --scopes read --json
COMMANDER_API_TOKEN=
# Approve/deny uchun alohida token, `read,approve` scope (faqat server tomonda, faqat qaror yo'lida ishlatiladi):
#   bash ops/mac/commander-admin.sh token create --kind web --name dashboard-approve --scopes read,approve --json
# Bo'sh bo'lsa approval tugmalari o'chiq (faqat ko'rish).
COMMANDER_APPROVE_TOKEN=
# Ko'rsatilmaydigan mashinalar (hostname yoki slug, vergul bilan). legacy_unverified mashinalar doim yashiriladi.
DASHBOARD_HIDE_MACHINES=
# Qo'shimcha ruxsat etilgan Host nomlari (faqat 127.0.0.1 dan boshqa manzildan kirsangiz)
DASHBOARD_ALLOWED_HOSTS=
# Masofaviy boshqaruv tokeni, `read,control` scope (faqat server tomonda; prompt/stop/yangi sessiya):
#   bash ops/mac/commander-admin.sh token create --kind web --name dashboard-control --scopes read,control --json
# Bo'sh bo'lsa dashboard'da boshqaruv tugmalari o'chiq.
COMMANDER_CONTROL_TOKEN=
